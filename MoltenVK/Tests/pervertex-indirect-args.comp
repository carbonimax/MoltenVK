// Writes indirect arguments, Count and indices on the GPU, after the host zeroed the target.
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) readonly buffer Source { uint source[]; };
layout(std430, set = 0, binding = 1) writeonly buffer Target { uint target[]; };
void main() { uint i = gl_GlobalInvocationID.x; if (i < 128u) { target[i] = source[i]; } }
